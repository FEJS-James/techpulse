---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-gray-950 text-gray-200 antialiased">
		<nav class="sticky top-0 z-50 bg-gray-950/80 backdrop-blur-xl border-b border-gray-800/50">
			<div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
				<a href="/" class="text-xl font-black tracking-tight">
					<span class="text-white">Tech</span><span class="text-red-500">Pulse</span><span class="text-gray-500 font-normal text-sm ml-1">Daily</span>
				</a>
				<div class="flex items-center gap-6 text-sm font-medium text-gray-400">
					<a href="/" class="hover:text-white transition">Home</a>
					<a href="/blog" class="hover:text-white transition">Articles</a>
					<a href="/about" class="hover:text-white transition">About</a>
				</div>
			</div>
		</nav>

		<main class="max-w-3xl mx-auto px-6 py-12">
			<article>
				<header class="mb-10">
					<p class="text-sm text-red-400 font-medium uppercase tracking-wider mb-3">
						<FormattedDate date={pubDate} />
						{updatedDate && <span class="text-gray-600 ml-2">· Updated <FormattedDate date={updatedDate} /></span>}
					</p>
					<h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-white leading-tight mb-4">{title}</h1>
					<p class="text-lg text-gray-400 leading-relaxed">{description}</p>
					<div class="mt-6 h-px bg-gradient-to-r from-red-500 via-red-800 to-transparent"></div>
				</header>
				<div class="prose max-w-none">
					<slot />
				</div>
			</article>
		</main>

		<footer class="bg-gray-950 border-t border-gray-800/50 mt-20">
			<div class="max-w-6xl mx-auto px-6 py-12">
				<div class="flex flex-col md:flex-row justify-between items-center gap-4">
					<div>
						<p class="font-bold text-lg"><span class="text-white">Tech</span><span class="text-red-500">Pulse</span> <span class="text-gray-600 font-normal text-sm">Daily</span></p>
						<p class="text-gray-500 text-sm">Your daily dose of tech news and analysis.</p>
					</div>
					<div class="flex gap-6 text-sm text-gray-500">
						<a href="/blog" class="hover:text-white transition">Articles</a>
						<a href="/about" class="hover:text-white transition">About</a>
						<a href="https://commercialcoding.com" target="_blank" class="hover:text-white transition">Commercial Coding</a>
					</div>
				</div>
				<p class="text-xs text-gray-700 mt-8 text-center">&copy; 2026 TechPulse Daily. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>
