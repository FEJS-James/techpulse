---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "AboutPage",
	"name": `About — ${SITE_TITLE}`,
	"description": "About TechPulse Daily — independent tech journalism covering gaming, hardware, AI, and the future of technology.",
	"url": Astro.url,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="About TechPulse Daily — independent tech journalism covering gaming, hardware, AI, and the future of technology." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<style>
			body { font-family: 'Space Grotesk', system-ui, sans-serif; }
			.dot-pattern { background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 24px 24px; }
		</style>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-[#030308] text-gray-300 antialiased">

		<!-- Nav -->
		<nav class="sticky top-0 z-50 bg-[#030308]/90 backdrop-blur-xl border-b border-white/5">
			<div class="max-w-7xl mx-auto px-6 lg:px-10 py-4 flex items-center justify-between">
				<a href="/" class="text-2xl font-extrabold tracking-tight">
					<span class="text-white">tech</span><span class="text-red-500">pulse</span>
				</a>
				<div class="flex items-center gap-6 text-sm font-medium text-gray-400">
					<a href="/" class="hover:text-white transition">Home</a>
					<a href="/blog" class="hover:text-white transition">Articles</a>
					<a href="/about" class="text-white font-semibold">About</a>
				</div>
			</div>
		</nav>

		<main class="dot-pattern">
			<!-- Hero -->
			<section class="relative overflow-hidden border-b border-white/5">
				<div class="absolute inset-0 bg-gradient-to-br from-red-950/20 via-[#030308] to-[#030308]"></div>
				<div class="relative max-w-4xl mx-auto px-6 lg:px-10 py-20 md:py-28 text-center">
					<div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full bg-red-500/10 border border-red-500/20">
						<span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
						<span class="text-red-400 text-[11px] font-bold uppercase tracking-widest">About Us</span>
					</div>
					<h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight mb-6">Independent tech<br>journalism, <span class="text-red-500">unfiltered</span>.</h1>
					<p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">We cover gaming, hardware, AI, and the future of technology. No corporate sponsors. No fluff. Just sharp analysis from people who actually use the stuff we write about.</p>
				</div>
			</section>

			<!-- Content -->
			<section class="max-w-3xl mx-auto px-6 lg:px-10 py-16">
				<div class="space-y-12">
					<!-- Mission -->
					<div>
						<div class="flex items-center gap-3 mb-4">
							<div class="w-1 h-6 bg-red-500 rounded-full"></div>
							<h2 class="text-xl font-bold text-white uppercase tracking-wider">Our Mission</h2>
						</div>
						<p class="text-gray-400 leading-relaxed text-base">TechPulse Daily was born out of frustration with the state of tech media. Too many publications are more interested in SEO games and affiliate revenue than actually helping readers make informed decisions. We wanted something different — a publication that respects your time and intelligence.</p>
						<p class="text-gray-400 leading-relaxed text-base mt-4">Every article we publish aims to answer one question: <strong class="text-white">"What does this actually mean for you?"</strong> We skip the filler, cut through the marketing, and tell you what matters.</p>
					</div>

					<!-- What We Cover -->
					<div>
						<div class="flex items-center gap-3 mb-6">
							<div class="w-1 h-6 bg-red-500 rounded-full"></div>
							<h2 class="text-xl font-bold text-white uppercase tracking-wider">What We Cover</h2>
						</div>
						<div class="grid sm:grid-cols-2 gap-4">
							{[
								{ icon: '🎮', title: 'Gaming', desc: 'Console wars, PC builds, game reviews, and industry analysis.' },
								{ icon: '🔧', title: 'Hardware', desc: 'GPUs, CPUs, peripherals — tested and benchmarked in-house.' },
								{ icon: '🤖', title: 'AI & ML', desc: 'LLMs, agents, automation, and the cutting edge of artificial intelligence.' },
								{ icon: '🍎', title: 'Apple', desc: 'iOS, macOS, hardware launches, and the Apple ecosystem.' },
								{ icon: '🐧', title: 'Open Source', desc: 'Linux, FOSS tools, community projects, and developer culture.' },
								{ icon: '⚡', title: 'Breaking News', desc: 'Industry shakeups, launches, and the stories that matter — fast.' },
							].map(item => (
								<div class="p-5 rounded-xl bg-white/[0.02] border border-white/5 hover:border-red-500/20 transition-all duration-300">
									<span class="text-2xl mb-3 block">{item.icon}</span>
									<h3 class="text-sm font-bold text-white mb-1">{item.title}</h3>
									<p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
								</div>
							))}
						</div>
					</div>

					<!-- Built By -->
					<div>
						<div class="flex items-center gap-3 mb-4">
							<div class="w-1 h-6 bg-red-500 rounded-full"></div>
							<h2 class="text-xl font-bold text-white uppercase tracking-wider">Built By</h2>
						</div>
						<p class="text-gray-400 leading-relaxed text-base">TechPulse is a project by <a href="https://commercialcoding.com" target="_blank" rel="noopener" class="text-red-400 hover:text-red-300 underline underline-offset-4 transition">Commercial Coding</a> — a software consultancy that builds web apps, AI integrations, and custom tools for startups and enterprises. We build the tech we write about.</p>
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="max-w-3xl mx-auto px-6 lg:px-10 pb-20">
				<div class="relative rounded-2xl overflow-hidden border border-white/5">
					<div class="absolute inset-0 bg-gradient-to-r from-red-950/40 via-[#0a0a12] to-[#0a0a12]"></div>
					<div class="absolute inset-0 dot-pattern opacity-50"></div>
					<div class="relative p-10 text-center">
						<h2 class="text-2xl font-extrabold text-white mb-3">Want to work with us?</h2>
						<p class="text-gray-400 mb-6 max-w-lg mx-auto">Whether you need a full-stack app, an AI agent, or just good advice — we ship production code.</p>
						<a href="https://commercialcoding.com" target="_blank" rel="noopener" class="inline-block bg-red-500 hover:bg-red-400 text-white px-8 py-3.5 rounded-full font-bold transition-all duration-300 text-sm shadow-lg shadow-red-500/20 hover:shadow-red-500/40">
							Visit commercialcoding.com →
						</a>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="border-t border-white/5 bg-[#020206]">
			<div class="max-w-7xl mx-auto px-6 lg:px-10 py-12 flex flex-col md:flex-row justify-between items-center gap-6">
				<p class="text-xl font-extrabold"><span class="text-white">tech</span><span class="text-red-500">pulse</span></p>
				<div class="flex gap-6 text-xs text-gray-500 font-medium">
					<a href="/blog" class="hover:text-white transition">Articles</a>
					<a href="/about" class="hover:text-white transition">About</a>
					<a href="https://commercialcoding.com" target="_blank" class="hover:text-white transition">Commercial Coding</a>
				</div>
				<p class="text-[11px] text-gray-700">© 2026 TechPulse Daily</p>
			</div>
		</footer>
	</body>
</html>
