---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const hero = posts[0];
const secondary = posts.slice(1, 3);
const trending = posts.slice(0, 5);
const rest = posts.slice(3);

const heroImages: Record<string, string> = {
	'Gaming': 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=800&q=80',
	'Console': 'https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?w=800&q=80',
	'AI': 'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&q=80',
	'GPU': 'https://images.unsplash.com/photo-1591488320449-011701bb6704?w=800&q=80',
	'Open Source': 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&q=80',
	'default': 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&q=80',
};

function getImage(tags?: string[]) {
	if (!tags?.length) return heroImages['default'];
	for (const tag of tags) {
		if (heroImages[tag]) return heroImages[tag];
	}
	return heroImages['default'];
}

function readTime(desc: string) {
	return Math.max(3, Math.ceil(desc.length / 200)) + ' min read';
}

const tagColors: Record<string, string> = {
	'AI': 'bg-purple-500/20 text-purple-300 border-purple-500/30',
	'Gaming': 'bg-green-500/20 text-green-300 border-green-500/30',
	'Console': 'bg-blue-500/20 text-blue-300 border-blue-500/30',
	'GPU': 'bg-orange-500/20 text-orange-300 border-orange-500/30',
	'PC Hardware': 'bg-orange-500/20 text-orange-300 border-orange-500/30',
	'Open Source': 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
	'NVIDIA': 'bg-lime-500/20 text-lime-300 border-lime-500/30',
	'OpenClaw': 'bg-red-500/20 text-red-300 border-red-500/30',
	'Automation': 'bg-yellow-500/20 text-yellow-300 border-yellow-500/30',
};
function tagColor(tag: string) {
	return tagColors[tag] || 'bg-gray-500/20 text-gray-300 border-gray-500/30';
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"description": SITE_DESCRIPTION,
	"url": Astro.site || Astro.url.origin,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<style>
			body { font-family: 'Space Grotesk', system-ui, sans-serif; }
			@keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 4px rgba(239,68,68,0.4); } 50% { box-shadow: 0 0 12px rgba(239,68,68,0.8); } }
			@keyframes scroll-left { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
			.pulse-dot { animation: pulse-glow 2s ease-in-out infinite; }
			.ticker-scroll { animation: scroll-left 30s linear infinite; }
			.card-glow:hover { box-shadow: 0 0 30px rgba(239,68,68,0.08), 0 0 60px rgba(239,68,68,0.04); }
			.dot-pattern { background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 24px 24px; }
		</style>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-[#030308] text-gray-300 antialiased">

		<!-- Breaking News Ticker -->
		<div class="bg-gradient-to-r from-red-600 via-red-500 to-red-600 overflow-hidden">
			<div class="flex items-center h-9">
				<span class="bg-red-800 text-white text-[10px] font-bold uppercase tracking-widest px-4 h-full flex items-center shrink-0 z-10">Breaking</span>
				<div class="overflow-hidden flex-1 relative">
					<div class="ticker-scroll flex whitespace-nowrap gap-12 text-white/90 text-xs font-medium py-2 pl-4">
						<span>🔴 {hero?.data.title}</span>
						<span>⚡ {secondary[0]?.data.title}</span>
						<span>🚀 {secondary[1]?.data.title}</span>
						<span>🔴 {hero?.data.title}</span>
						<span>⚡ {secondary[0]?.data.title}</span>
						<span>🚀 {secondary[1]?.data.title}</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Nav -->
		<nav class="sticky top-0 z-50 bg-[#030308]/90 backdrop-blur-xl border-b border-white/5">
			<div class="max-w-7xl mx-auto px-6 lg:px-10">
				<div class="flex items-center justify-between py-4">
					<a href="/" class="text-2xl font-extrabold tracking-tight">
						<span class="text-white">tech</span><span class="text-red-500">pulse</span>
					</a>
					<div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-400">
						<a href="/" class="text-white">Home</a>
						<a href="/blog" class="hover:text-white transition">Articles</a>
						<a href="/about" class="hover:text-white transition">About</a>
					</div>
					<span class="text-[11px] text-gray-600 font-mono hidden lg:block">
						{new Date().toLocaleDateString('en-us', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
					</span>
				</div>
				<!-- Category Bar -->
				<div class="flex items-center gap-5 pb-3 text-[11px] font-semibold text-gray-500 uppercase tracking-widest overflow-x-auto scrollbar-hide">
					{['Gaming', 'Hardware', 'AI', 'Apple', 'Open Source'].map((cat) => (
						<a href="/blog" class="hover:text-red-400 transition whitespace-nowrap">{cat}</a>
					))}
				</div>
			</div>
		</nav>

		<main class="dot-pattern">
			<!-- Hero Section -->
			<section class="max-w-7xl mx-auto px-6 lg:px-10 pt-10 pb-6">
				<div class="grid lg:grid-cols-3 gap-1.5">
					<!-- Featured Story (2/3) -->
					{hero && (
						<a href={`/blog/${hero.id}/`} class="lg:col-span-2 group relative rounded-2xl overflow-hidden block min-h-[420px]">
							<img src={getImage(hero.data.tags)} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager" />
							<div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>
							<div class="absolute inset-0 bg-gradient-to-r from-black/30 to-transparent"></div>
							<div class="relative h-full flex flex-col justify-end p-8 lg:p-12">
								<div class="flex items-center gap-3 mb-4">
									<span class="w-2.5 h-2.5 bg-red-500 rounded-full pulse-dot"></span>
									<span class="text-red-400 text-[11px] font-bold uppercase tracking-widest">Latest</span>
									{hero.data.tags?.map((tag: string) => (
										<span class={`text-[10px] font-semibold px-2.5 py-0.5 rounded-full border ${tagColor(tag)}`}>{tag}</span>
									))}
								</div>
								<h1 class="text-3xl lg:text-4xl xl:text-5xl font-extrabold text-white leading-[1.1] mb-4 group-hover:text-red-300 transition-colors duration-300">{hero.data.title}</h1>
								<p class="text-gray-300 text-base lg:text-lg leading-relaxed max-w-2xl mb-4 line-clamp-2">{hero.data.description}</p>
								<div class="flex items-center gap-3 text-xs text-gray-400 font-mono">
									<span>{new Date(hero.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
									<span class="text-gray-600">·</span>
									<span>{readTime(hero.data.description)}</span>
								</div>
							</div>
						</a>
					)}

					<!-- Side Stack (1/3) -->
					<div class="flex flex-col gap-1.5">
						{secondary.map((post, i) => (
							<a href={`/blog/${post.id}/`} class="group relative rounded-2xl overflow-hidden block flex-1 min-h-[200px]">
								<img src={getImage(post.data.tags)} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading={i === 0 ? 'eager' : 'lazy'} />
								<div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/20"></div>
								<div class="relative h-full flex flex-col justify-end p-6">
									<div class="flex items-center gap-2 mb-2">
										{post.data.tags?.[0] && (
											<span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${tagColor(post.data.tags[0])}`}>{post.data.tags[0]}</span>
										)}
									</div>
									<h2 class="text-lg font-bold text-white leading-snug group-hover:text-red-300 transition-colors duration-300">{post.data.title}</h2>
									<span class="mt-2 text-[11px] text-gray-400 font-mono">
										{new Date(post.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric' })}
									</span>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Trending Section -->
			<section class="max-w-7xl mx-auto px-6 lg:px-10 py-12">
				<div class="flex items-center gap-4 mb-8">
					<div class="flex items-center gap-2">
						<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z"/></svg>
						<h2 class="text-sm font-bold text-white uppercase tracking-widest">Trending Now</h2>
					</div>
					<div class="flex-1 h-px bg-gradient-to-r from-white/10 to-transparent"></div>
				</div>
				<div class="grid md:grid-cols-5 gap-4">
					{trending.map((post, i) => (
						<a href={`/blog/${post.id}/`} class="group flex md:flex-col gap-4 items-start p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-red-500/20 hover:bg-white/[0.04] transition-all duration-300">
							<span class="text-4xl font-black text-red-500/20 group-hover:text-red-500/40 transition shrink-0 leading-none">{String(i + 1).padStart(2, '0')}</span>
							<div>
								<h3 class="text-sm font-bold text-white leading-snug group-hover:text-red-300 transition-colors">{post.data.title}</h3>
								<p class="text-[11px] text-gray-600 mt-1 font-mono">{new Date(post.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric' })}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- More Stories Grid -->
			{rest.length > 0 && (
				<section class="max-w-7xl mx-auto px-6 lg:px-10 pb-16">
					<div class="flex items-center gap-4 mb-8">
						<h2 class="text-sm font-bold text-white uppercase tracking-widest">More Stories</h2>
						<div class="flex-1 h-px bg-gradient-to-r from-white/10 to-transparent"></div>
					</div>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
						{rest.map((post) => (
							<a href={`/blog/${post.id}/`} class="group block rounded-2xl overflow-hidden bg-white/[0.02] border border-white/5 hover:border-red-500/20 card-glow transition-all duration-300">
								<div class="relative h-48 overflow-hidden">
									<img src={getImage(post.data.tags)} alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
									<div class="absolute inset-0 bg-gradient-to-t from-[#030308] to-transparent"></div>
								</div>
								<div class="p-6">
									<div class="flex items-center gap-2 mb-3">
										{post.data.tags?.slice(0,2).map((tag: string) => (
											<span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${tagColor(tag)}`}>{tag}</span>
										))}
									</div>
									<h3 class="text-base font-bold text-white group-hover:text-red-300 transition-colors leading-snug mb-2">{post.data.title}</h3>
									<p class="text-gray-500 text-sm line-clamp-2 leading-relaxed mb-3">{post.data.description}</p>
									<div class="flex items-center gap-2 text-[11px] text-gray-600 font-mono">
										<span>{new Date(post.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric' })}</span>
										<span>·</span>
										<span>{readTime(post.data.description)}</span>
									</div>
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			<!-- CTA Banner -->
			<section class="max-w-7xl mx-auto px-6 lg:px-10 pb-20">
				<div class="relative rounded-2xl overflow-hidden border border-white/5">
					<div class="absolute inset-0 bg-gradient-to-r from-red-950/40 via-[#0a0a12] to-[#0a0a12]"></div>
					<div class="absolute inset-0 dot-pattern opacity-50"></div>
					<div class="relative p-10 lg:p-14 flex flex-col lg:flex-row items-center justify-between gap-8">
						<div>
							<p class="text-red-400 text-[11px] font-bold uppercase tracking-widest mb-2">From the makers of TechPulse</p>
							<h2 class="text-2xl lg:text-3xl font-extrabold text-white mb-2">Need tech built right?</h2>
							<p class="text-gray-400 max-w-lg">Web apps, AI integrations, custom software — we ship production code for startups and enterprises.</p>
						</div>
						<a href="https://commercialcoding.com" target="_blank" rel="noopener" class="shrink-0 bg-red-500 hover:bg-red-400 text-white px-8 py-3.5 rounded-full font-bold transition-all duration-300 text-sm shadow-lg shadow-red-500/20 hover:shadow-red-500/40">
							commercialcoding.com →
						</a>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="border-t border-white/5 bg-[#020206]">
			<div class="max-w-7xl mx-auto px-6 lg:px-10 py-12">
				<div class="flex flex-col md:flex-row justify-between items-center gap-6">
					<div>
						<p class="text-xl font-extrabold"><span class="text-white">tech</span><span class="text-red-500">pulse</span></p>
						<p class="text-gray-600 text-sm mt-1">Your daily dose of tech news and analysis.</p>
					</div>
					<div class="flex gap-6 text-xs text-gray-500 font-medium">
						<a href="/blog" class="hover:text-white transition">Articles</a>
						<a href="/about" class="hover:text-white transition">About</a>
						<a href="https://commercialcoding.com" target="_blank" class="hover:text-red-400 transition">Commercial Coding</a>
					</div>
				</div>
				<div class="mt-8 pt-6 border-t border-white/5 text-center">
					<p class="text-[11px] text-gray-700">© 2026 TechPulse Daily. All rights reserved.</p>
				</div>
			</div>
		</footer>
	</body>
</html>
