---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const hero = posts[0];
const secondary = posts.slice(1, 3);
const rest = posts.slice(3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
		<style>body{font-family:'Space Grotesk',system-ui,sans-serif}</style>
	</head>
	<body class="bg-[#0a0a0f] text-gray-300 antialiased">

		<!-- Nav — news-style top bar -->
		<nav class="border-b border-white/5">
			<div class="max-w-7xl mx-auto px-6 lg:px-10">
				<!-- Top line: branding + date -->
				<div class="flex items-center justify-between py-4 border-b border-white/5">
					<a href="/" class="text-2xl font-bold tracking-tight">
						<span class="text-white">tech</span><span class="text-red-500">pulse</span>
					</a>
					<span class="text-xs text-gray-600 font-mono">
						{new Date().toLocaleDateString('en-us', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
					</span>
				</div>
				<!-- Bottom line: nav links -->
				<div class="flex items-center gap-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider overflow-x-auto">
					<a href="/blog" class="hover:text-white transition whitespace-nowrap">All Stories</a>
					<span class="text-gray-800">|</span>
					<span class="text-gray-600">Gaming</span>
					<span class="text-gray-600">Hardware</span>
					<span class="text-gray-600">AI</span>
					<span class="text-gray-600">Apple</span>
					<span class="text-gray-600">Open Source</span>
				</div>
			</div>
		</nav>

		<main>
			<!-- Hero Grid — newspaper-style -->
			<section class="max-w-7xl mx-auto px-6 lg:px-10 py-10">
				<div class="grid lg:grid-cols-3 gap-px bg-white/5 rounded-2xl overflow-hidden">
					<!-- Main story — spans 2 cols -->
					{hero && (
						<a href={`/blog/${hero.id}/`} class="lg:col-span-2 bg-[#0f0f18] p-8 lg:p-12 group block hover:bg-[#12121f] transition">
							<div class="flex items-center gap-3 mb-5">
								<span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
								<span class="text-red-400 text-xs font-bold uppercase tracking-wider">Top Story</span>
								{hero.data.tags?.[0] && <span class="text-xs text-gray-600 border border-gray-800 px-2 py-0.5 rounded">{hero.data.tags[0]}</span>}
							</div>
							<h1 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-white leading-tight mb-4 group-hover:text-red-400 transition">{hero.data.title}</h1>
							<p class="text-gray-400 text-lg leading-relaxed max-w-2xl mb-6">{hero.data.description}</p>
							<span class="text-sm text-gray-600 font-mono">
								{new Date(hero.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric' })} · 5 min read
							</span>
						</a>
					)}

					<!-- Side stack — 2 stories -->
					<div class="flex flex-col divide-y divide-white/5">
						{secondary.map((post) => (
							<a href={`/blog/${post.id}/`} class="bg-[#0f0f18] p-6 lg:p-8 group block hover:bg-[#12121f] transition flex-1">
								{post.data.tags?.[0] && <span class="text-xs text-gray-600 border border-gray-800 px-2 py-0.5 rounded">{post.data.tags[0]}</span>}
								<h2 class="text-lg lg:text-xl font-bold text-white leading-snug mt-3 mb-2 group-hover:text-red-400 transition">{post.data.title}</h2>
								<p class="text-gray-500 text-sm leading-relaxed line-clamp-3">{post.data.description}</p>
								<span class="block mt-3 text-xs text-gray-600 font-mono">
									{new Date(post.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric' })}
								</span>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- More stories -->
			{rest.length > 0 && (
				<section class="max-w-7xl mx-auto px-6 lg:px-10 pb-16">
					<div class="flex items-center gap-4 mb-8">
						<h2 class="text-xs font-bold text-gray-500 uppercase tracking-widest">More Stories</h2>
						<div class="flex-1 h-px bg-white/5"></div>
					</div>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
						{rest.map((post) => (
							<a href={`/blog/${post.id}/`} class="group block bg-[#0f0f18] rounded-xl p-6 border border-white/5 hover:border-red-900/30 transition">
								{post.data.tags?.[0] && <span class="text-xs text-gray-600 mb-3 block">{post.data.tags[0]}</span>}
								<h3 class="text-base font-bold text-white group-hover:text-red-400 transition leading-snug mb-2">{post.data.title}</h3>
								<p class="text-gray-600 text-sm">{new Date(post.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric' })}</p>
							</a>
						))}
					</div>
				</section>
			)}

			<!-- CTA banner -->
			<section class="max-w-7xl mx-auto px-6 lg:px-10 pb-16">
				<div class="bg-gradient-to-r from-red-950/50 via-[#0f0f18] to-[#0f0f18] rounded-2xl border border-white/5 p-10 lg:p-14 flex flex-col lg:flex-row items-center justify-between gap-8">
					<div>
						<h2 class="text-2xl font-bold text-white mb-2">Need tech built right?</h2>
						<p class="text-gray-400">Web apps, AI integrations, custom software. We ship production code.</p>
					</div>
					<a href="https://commercialcoding.com" target="_blank" class="shrink-0 bg-white text-gray-900 px-7 py-3.5 rounded-full font-bold hover:bg-gray-100 transition text-sm">
						commercialcoding.com →
					</a>
				</div>
			</section>
		</main>

		<!-- Footer — minimal -->
		<footer class="border-t border-white/5">
			<div class="max-w-7xl mx-auto px-6 lg:px-10 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
				<p class="text-sm font-bold"><span class="text-white">tech</span><span class="text-red-500">pulse</span></p>
				<div class="flex gap-6 text-xs text-gray-600">
					<a href="/blog" class="hover:text-white transition">Stories</a>
					<a href="/about" class="hover:text-white transition">About</a>
					<a href="https://commercialcoding.com" target="_blank" class="hover:text-white transition">Commercial Coding</a>
				</div>
				<p class="text-xs text-gray-700">© 2026</p>
			</div>
		</footer>
	</body>
</html>
