---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))];

const heroImages: Record<string, string> = {
	'Gaming': 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=600&q=80',
	'Console': 'https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?w=600&q=80',
	'AI': 'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&q=80',
	'GPU': 'https://images.unsplash.com/photo-1591488320449-011701bb6704?w=600&q=80',
	'PC Hardware': 'https://images.unsplash.com/photo-1591488320449-011701bb6704?w=600&q=80',
	'Open Source': 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&q=80',
	'default': 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&q=80',
};
function getImage(tags?: string[]) {
	if (!tags?.length) return heroImages['default'];
	for (const tag of tags) { if (heroImages[tag]) return heroImages[tag]; }
	return heroImages['default'];
}
function readTime(desc: string) {
	return Math.max(3, Math.ceil(desc.length / 200)) + ' min read';
}
const tagColors: Record<string, string> = {
	'AI': 'bg-purple-500/20 text-purple-300 border-purple-500/30',
	'Gaming': 'bg-green-500/20 text-green-300 border-green-500/30',
	'Console': 'bg-blue-500/20 text-blue-300 border-blue-500/30',
	'GPU': 'bg-orange-500/20 text-orange-300 border-orange-500/30',
	'PC Hardware': 'bg-orange-500/20 text-orange-300 border-orange-500/30',
	'Open Source': 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
	'NVIDIA': 'bg-lime-500/20 text-lime-300 border-lime-500/30',
	'OpenClaw': 'bg-red-500/20 text-red-300 border-red-500/30',
	'Automation': 'bg-yellow-500/20 text-yellow-300 border-yellow-500/30',
	'Anthropic': 'bg-amber-500/20 text-amber-300 border-amber-500/30',
	'OpenAI': 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
	'LLMs': 'bg-violet-500/20 text-violet-300 border-violet-500/30',
	'Reviews': 'bg-pink-500/20 text-pink-300 border-pink-500/30',
	'PlayStation': 'bg-blue-500/20 text-blue-300 border-blue-500/30',
	'Xbox': 'bg-green-500/20 text-green-300 border-green-500/30',
};
function tagColor(tag: string) {
	return tagColors[tag] || 'bg-gray-500/20 text-gray-300 border-gray-500/30';
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": `Articles — ${SITE_TITLE}`,
	"description": SITE_DESCRIPTION,
	"url": Astro.url,
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Articles — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<style>
			body { font-family: 'Space Grotesk', system-ui, sans-serif; }
			.card-glow:hover { box-shadow: 0 0 30px rgba(239,68,68,0.08), 0 0 60px rgba(239,68,68,0.04); }
			.dot-pattern { background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 24px 24px; }
			.tag-btn.active { background: rgba(239,68,68,0.2); color: #fca5a5; border-color: rgba(239,68,68,0.4); }
		</style>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-[#030308] text-gray-300 antialiased">

		<!-- Nav -->
		<nav class="sticky top-0 z-50 bg-[#030308]/90 backdrop-blur-xl border-b border-white/5">
			<div class="max-w-7xl mx-auto px-6 lg:px-10">
				<div class="flex items-center justify-between py-4">
					<a href="/" class="text-2xl font-extrabold tracking-tight">
						<span class="text-white">tech</span><span class="text-red-500">pulse</span>
					</a>
					<div class="flex items-center gap-6 text-sm font-medium text-gray-400">
						<a href="/" class="hover:text-white transition">Home</a>
						<a href="/blog" class="text-white font-semibold">Articles</a>
						<a href="/about" class="hover:text-white transition">About</a>
					</div>
				</div>
			</div>
		</nav>

		<main class="dot-pattern">
			<!-- Header -->
			<section class="relative overflow-hidden border-b border-white/5">
				<div class="absolute inset-0 bg-gradient-to-br from-red-950/30 via-[#030308] to-[#030308]"></div>
				<div class="relative max-w-7xl mx-auto px-6 lg:px-10 py-16 md:py-20">
					<div class="flex items-center gap-3 mb-4">
						<div class="w-1 h-8 bg-red-500 rounded-full"></div>
						<span class="text-red-400 font-bold text-[11px] uppercase tracking-widest">The Feed</span>
					</div>
					<h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">All Articles</h1>
					<p class="text-gray-400 text-lg max-w-xl">Gaming, hardware, AI, and everything tech — updated daily.</p>
				</div>
			</section>

			<!-- Tag Filters -->
			<section class="max-w-7xl mx-auto px-6 lg:px-10 pt-10 pb-2">
				<div class="flex flex-wrap gap-2" id="tag-filters">
					<button data-tag="all" class="tag-btn active text-[11px] font-semibold px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.03] text-gray-400 hover:text-white transition cursor-pointer">All</button>
					{allTags.map(tag => (
						<button data-tag={tag} class={`tag-btn text-[11px] font-semibold px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.03] text-gray-400 hover:text-white transition cursor-pointer`}>{tag}</button>
					))}
				</div>
			</section>

			<!-- Masonry Grid -->
			<section class="max-w-7xl mx-auto px-6 lg:px-10 py-10">
				<div class="columns-1 md:columns-2 lg:columns-3 gap-5 space-y-5" id="articles-grid">
					{posts.map((post, i) => (
						<a href={`/blog/${post.id}/`} data-tags={JSON.stringify(post.data.tags || [])} class="article-card group block break-inside-avoid rounded-2xl overflow-hidden bg-white/[0.02] border border-white/5 hover:border-red-500/20 card-glow transition-all duration-300">
							<div class="relative overflow-hidden" style={`height: ${i % 3 === 0 ? '240px' : '180px'}`}>
								<img src={getImage(post.data.tags)} alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
								<div class="absolute inset-0 bg-gradient-to-t from-[#030308] via-[#030308]/40 to-transparent"></div>
								{i === 0 && (
									<div class="absolute top-3 left-3 flex items-center gap-1.5 bg-red-500/90 backdrop-blur-sm rounded-full px-2.5 py-1">
										<span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
										<span class="text-white text-[10px] font-bold uppercase">Latest</span>
									</div>
								)}
							</div>
							<div class="p-5">
								<div class="flex flex-wrap items-center gap-1.5 mb-3">
									{post.data.tags?.map((tag: string) => (
										<span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${tagColor(tag)}`}>{tag}</span>
									))}
								</div>
								<h2 class="text-base font-bold text-white group-hover:text-red-300 transition-colors leading-snug mb-2">{post.data.title}</h2>
								<p class="text-gray-500 text-sm line-clamp-2 leading-relaxed mb-3">{post.data.description}</p>
								<div class="flex items-center gap-2 text-[11px] text-gray-600 font-mono">
									<span>{new Date(post.data.pubDate).toLocaleDateString('en-us', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
									<span>·</span>
									<span>{readTime(post.data.description)}</span>
								</div>
							</div>
						</a>
					))}
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="border-t border-white/5 bg-[#020206]">
			<div class="max-w-7xl mx-auto px-6 lg:px-10 py-12 flex flex-col md:flex-row justify-between items-center gap-6">
				<p class="text-xl font-extrabold"><span class="text-white">tech</span><span class="text-red-500">pulse</span></p>
				<div class="flex gap-6 text-xs text-gray-500 font-medium">
					<a href="/blog" class="hover:text-white transition">Articles</a>
					<a href="/about" class="hover:text-white transition">About</a>
					<a href="https://commercialcoding.com" target="_blank" class="hover:text-white transition">Commercial Coding</a>
				</div>
				<p class="text-[11px] text-gray-700">© 2026 TechPulse Daily</p>
			</div>
		</footer>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const btns = document.querySelectorAll('.tag-btn');
				const cards = document.querySelectorAll('.article-card');
				btns.forEach(btn => {
					btn.addEventListener('click', () => {
						btns.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');
						const tag = btn.getAttribute('data-tag');
						cards.forEach(card => {
							const el = card as HTMLElement;
							if (tag === 'all') { el.style.display = ''; return; }
							const tags = JSON.parse(el.getAttribute('data-tags') || '[]');
							el.style.display = tags.includes(tag) ? '' : 'none';
						});
					});
				});
			});
		</script>
	</body>
</html>
